# HTML: fara cache, ca sa vezi imediat modificarile dupa deploy.
/*.html
  Cache-Control: no-cache, must-revalidate

# Pagina principala la fel.
/
  Cache-Control: no-cache, must-revalidate

# Imagini: un an. Nu se schimba; daca le schimbi, redenumeste-le.
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# CSS si JS: o saptamana, cu revalidare. Purge Everything le improspateaza oricum.
/*.css
  Cache-Control: public, max-age=604800, must-revalidate
/*.js
  Cache-Control: public, max-age=604800, must-revalidate

# Datele oraselor: o zi.
/*.json
  Cache-Control: public, max-age=86400
